# =============================================================
# DJANGO
# =============================================================
SECRET_KEY=senha_forte_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# =============================================================
# POSTGRESQL
# =============================================================
POSTGRES_DB=beauty_formula
POSTGRES_USER=usuario_banco
POSTGRES_PASSWORD=senha_forte_aqui
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Usado só em prod.py (env.db). Precisa bater com os valores acima:
# postgres://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB
DATABASE_URL=postgres://usuario_banco:senha_forte_aqui@db:5432/beauty_formula

# =============================================================
# REDIS / CELERY
# =============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================
# MINIO — credenciais root (só usadas pelo setup-minio)
# =============================================================
MINIO_ROOT_USER=usuario_root_aqui
MINIO_ROOT_PASSWORD=senha_forte_aqui

# =============================================================
# MINIO — usuário IAM da aplicação
# =============================================================
MINIO_APP_USER=usuario_app_aqui
MINIO_APP_PASSWORD=senha_forte_aqui

# =============================================================
# MINIO — buckets e endpoints
# (os nomes dos buckets também estão fixos em infra/minio/app-policy.json)
# =============================================================
MINIO_BUCKET_MEDIA=beautyformulamedia
MINIO_BUCKET_STATIC=beautyformulastatic
MINIO_BUCKET_PRIVATE=beautyformulaprivate
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_URL=http://localhost:9000
MINIO_PUBLIC_URL=localhost:9000

# =============================================================
# AWS / S3 (django-storages — usa o usuário IAM, nunca o root)
# AWS_ACCESS_KEY_ID  = MINIO_APP_USER
# AWS_SECRET_ACCESS_KEY = MINIO_APP_PASSWORD
# =============================================================
AWS_ACCESS_KEY_ID=usuario_app_aqui
AWS_SECRET_ACCESS_KEY=senha_forte_aqui
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_STORAGE_BUCKET_NAME=beautyformulamedia
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_ACL=None
AWS_QUERYSTRING_AUTH=False
AWS_S3_FILE_OVERWRITE=False
AWS_S3_VERIFY=False

# =============================================================
# CRYPTOGRAPHY
# Chave Fernet (44 chars). Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================
FIELD_ENCRYPTION_KEY=gere_uma_chave_fernet_valida_aqui

# =============================================================
# EMAIL
# =============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=email_para_envio_de_emails_aqui
EMAIL_HOST_PASSWORD=senha_de_email_aqui
DEFAULT_FROM_EMAIL=email_para_envio_de_emails_aqui
ADMIN_EMAIL=email_de_admin_aqui

# =============================================================
# ASAAS
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
# A chave começa com "$": no .env escreva "\$$aact_..." (o código remove a "\")
# =============================================================
ASAAS_API_KEY=xxxxxxxx
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_CUSTOMER_ID=cus_xxxxxxxxxxxx
ASAAS_PAYMENT_DUE_DAYS=1
ASAAS_WEBHOOK_TOKEN=token_do_webhook_aqui

# =============================================================
# GOOGLE OAUTH
# =============================================================
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com

# =============================================================
# CORS / CSRF / COOKIES
# Front em outro domínio (Vercel + ngrok): COOKIE_SAMESITE=None + COOKIE_SECURE=True
# Tudo em localhost: COOKIE_SAMESITE=Lax
# CORS_ALLOWED_ORIGINS só é lido em prod.py (dev.py tem lista fixa)
# =============================================================
CSRF_TRUSTED_ORIGINS=https://SEU-PROJETO.vercel.app,https://SEU-TUNEL.ngrok-free.dev
CORS_ALLOWED_ORIGINS=https://SEU-PROJETO.vercel.app
COOKIE_SAMESITE=None
COOKIE_SECURE=True

# =============================================================
# SENTRY (opcional — vazio = desligado)
# =============================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# =============================================================
# E-MAILS
# =============================================================
STORE_NAME=Fórmula da Beleza
CONTACT_NOTIFICATION_EMAIL=email_de_admin_aqui