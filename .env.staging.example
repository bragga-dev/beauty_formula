# =============================================================================
# HOMOLOGAÇÃO — variáveis ADICIONAIS/DIFERENTES em relação ao .env.example.
# Copie .env.example para .env e aplique estes valores por cima.
# (Este arquivo não leva segredos: troque todos os <...>.)
# =============================================================================

# ── Domínios (usados pelo Nginx/compose e pelo certbot) ──────────────────────
APP_DOMAIN=homolog.exemplo.com.br
MEDIA_DOMAIN=media-homolog.exemplo.com.br
LETSENCRYPT_EMAIL=ti@exemplo.com.br
# LETSENCRYPT_STAGING=1        # descomente para testar a emissão sem gastar limite

# ── Django ───────────────────────────────────────────────────────────────────
DEBUG=False
ALLOWED_HOSTS=homolog.exemplo.com.br
FRONTEND_URL=https://homolog.exemplo.com.br
BACKEND_URL=https://homolog.exemplo.com.br
CSRF_TRUSTED_ORIGINS=https://homolog.exemplo.com.br
CORS_ALLOWED_ORIGINS=https://homolog.exemplo.com.br
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax            # front e API na mesma origem (Nginx serve os dois)

# ── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
# postgres://USER:PASSWORD@db:5432/DB  (senha sem caracteres especiais ou URL-encoded)
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>

# ── Redis: DOIS serviços (ver docker-compose.prod.yml) ───────────────────────
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_URL=redis://redis-cache:6379/1              # cache, sessões e rate-limit (LRU)
CELERY_BROKER_URL=redis://redis:6379/0            # fila (noeviction + AOF)
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── MinIO / mídia ────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
AWS_S3_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=media-homolog.exemplo.com.br     # = MEDIA_DOMAIN, sem https://
MINIO_EXTERNAL_URL=https://media-homolog.exemplo.com.br

# ── Capacidade (opcional; padrões em infra/gunicorn/gunicorn.conf.py) ────────
# GUNICORN_WORKERS=4            # = nº de vCPU
# GUNICORN_THREADS=8            # workers x threads = requisições simultâneas
# CELERY_CONCURRENCY=4

# ── Teste de carga (NUNCA em produção) ───────────────────────────────────────
# RATELIMIT_ENABLE=False

# ── LGPD: dados do Controlador (preenchem os Termos e a Política de Privacidade) ──
LEGAL_COMPANY_NAME=Razão Social do Estabelecimento
LEGAL_COMPANY_CNPJ=00.000.000/0000-00
LEGAL_COMPANY_ADDRESS=Rua Exemplo, 123, Bairro, Cidade - UF
LEGAL_CONTACT_EMAIL=contato@exemplo.com.br
LEGAL_DPO_NAME=Nome do Encarregado (DPO)
LEGAL_DPO_EMAIL=privacidade@exemplo.com.br
LEGAL_CONTACT_RETENTION_MONTHS=12
LEGAL_UNVERIFIED_ACCOUNT_RETENTION_DAYS=30