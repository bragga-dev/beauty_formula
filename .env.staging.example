# =============================================================================
# FÓRMULA DA BELEZA — AMBIENTE DE HOMOLOGAÇÃO / PRODUÇÃO
#
# Este arquivo é AUTOSSUFICIENTE: contém as variáveis do .env.example e as
# variáveis adicionais do docker-compose.prod.yml / infraestrutura de produção.
#
# Como usar:
#   1. Copie este arquivo para .env:
#      cp .env.staging.example .env
#   2. Substitua TODOS os valores <PREENCHER_...>.
#   3. Ajuste os domínios e provedores para homologação ou produção.
#   4. Não versione o .env real.
#
# IMPORTANTE:
# - Homologação e produção devem usar credenciais, bancos, buckets e chaves
#   diferentes. Não compartilhe segredos entre os ambientes.
# - Para homologação, use preferencialmente o sandbox do Asaas.
# - Para produção, use a URL e a chave de produção do Asaas.
# - Não gere uma nova FIELD_ENCRYPTION_KEY depois que houver dados criptografados.
# - DATABASE_URL deve corresponder exatamente aos dados POSTGRES_*.
# - Se a senha do PostgreSQL tiver caracteres especiais, faça URL-encoding
#   dela dentro de DATABASE_URL.
# =============================================================================


# =============================================================================
# 1. DOMÍNIOS / NGINX / TLS
# =============================================================================

# Domínio público do frontend e da API (ex.: app.exemplo.com.br)
APP_DOMAIN=<PREENCHER_DOMINIO_PRINCIPAL>

# Domínio público para servir arquivos/mídias (ex.: media.exemplo.com.br)
MEDIA_DOMAIN=<PREENCHER_DOMINIO_DE_MIDIA>

# E-mail usado pelo Let's Encrypt para avisos sobre certificados
LETSENCRYPT_EMAIL=<PREENCHER_EMAIL_ADMINISTRADOR>

# https = operação normal com TLS.
# bootstrap = modo temporário para emitir o primeiro certificado.
NGINX_MODE=https

# Descomente APENAS durante testes de emissão com o ambiente de staging
# do Let's Encrypt. Remova/comente depois de validar o processo.
# LETSENCRYPT_STAGING=1

# Tag da imagem Docker. Pode ser, por exemplo, um SHA ou versão de release.
IMAGE_TAG=latest


# =============================================================================
# 2. DJANGO
# =============================================================================

# Gere uma chave exclusiva e forte para cada ambiente.
# Exemplo de geração:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<PREENCHER_SECRET_KEY_DJANGO>

# Sempre False em homologação e produção.
DEBUG=False

# Hosts/domínios aceitos pelo Django, separados por vírgula e sem espaços.
ALLOWED_HOSTS=<PREENCHER_APP_DOMAIN>

# URL pública do frontend.
FRONTEND_URL=https://<PREENCHER_DOMINIO_PRINCIPAL>

# URL pública do backend/API.
BACKEND_URL=https://<PREENCHER_APP_DOMAIN>

# =============================================================================
# 3. POSTGRESQL
# =============================================================================

POSTGRES_DB=beauty_formula
POSTGRES_USER=<PREENCHER_USUARIO_POSTGRES>
POSTGRES_PASSWORD=<PREENCHER_SENHA_FORTE_POSTGRES>
# Dentro do Docker Compose, o hostname do serviço é "db".
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Deve corresponder a POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST,
# POSTGRES_PORT e POSTGRES_DB.
# Se a senha tiver @, :, /, #, %, ?, ou outros caracteres reservados,
# use URL-encoding na senha somente dentro desta URL.
DATABASE_URL=postgres://<PREENCHER_USUARIO_POSTGRES>:<PREENCHER_SENHA_URL_ENCODED>@db:5432/beauty_formula


# =============================================================================
# 4. REDIS / CELERY
# =============================================================================
# O docker-compose.prod.yml sobe DOIS Redis independentes:
# - redis: broker/resultados do Celery, com persistência;
# - redis-cache: cache, sessões e rate limit, descartável.
#
# REDIS_URL aponta para o serviço de cache conforme a configuração da aplicação.
# CELERY_* apontam para o Redis dedicado às filas do Celery.

REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_URL=redis://redis-cache:6379/1

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# =============================================================================
# 5. MINIO — CREDENCIAIS ADMINISTRATIVAS (ROOT)
# =============================================================================
# Usadas somente pelo serviço de provisionamento createbuckets.
# Não use estas credenciais nas configurações AWS_* da aplicação.

MINIO_ROOT_USER=<PREENCHER_USUARIO_ROOT_MINIO>
MINIO_ROOT_PASSWORD=<PREENCHER_SENHA_FORTE_ROOT_MINIO>


# =============================================================================
# 6. MINIO — USUÁRIO IAM DA APLICAÇÃO
# =============================================================================
# Usuário restrito pela policy da aplicação. As credenciais AWS_* abaixo
# devem repetir exatamente estes valores.

MINIO_APP_USER=<PREENCHER_USUARIO_IAM_MINIO>
MINIO_APP_PASSWORD=<PREENCHER_SENHA_FORTE_IAM_MINIO>


# =============================================================================
# 7. MINIO — BUCKETS E ENDPOINTS
# =============================================================================

MINIO_BUCKET_MEDIA=beautyformulamedia
MINIO_BUCKET_STATIC=beautyformulastatic
MINIO_BUCKET_PRIVATE=beautyformulaprivate

# Endpoint interno acessado pelos containers Docker.
MINIO_ENDPOINT=minio:9000

# URL externa do serviço MinIO, se algum componente precisar dela.
# Não exponha o console administrativo do MinIO publicamente.
MINIO_EXTERNAL_URL=https://<PREENCHER_DOMINIO_DE_MIDIA>

# Host público usado para montar URLs de mídia.
# Sem protocolo e sem barra final, conforme o padrão do projeto.
MINIO_PUBLIC_URL=<PREENCHER_DOMINIO_DE_MIDIA>


# =============================================================================
# 8. AWS S3 / DJANGO-STORAGES
# =============================================================================
# O projeto usa MinIO compatível com S3.
# AWS_ACCESS_KEY_ID = MINIO_APP_USER
# AWS_SECRET_ACCESS_KEY = MINIO_APP_PASSWORD

AWS_ACCESS_KEY_ID=<MESMO_VALOR_DE_MINIO_APP_USER>
AWS_SECRET_ACCESS_KEY=<MESMO_VALOR_DE_MINIO_APP_PASSWORD>
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_STORAGE_BUCKET_NAME=beautyformulamedia
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_ACL=None
AWS_QUERYSTRING_AUTH=False
AWS_S3_FILE_OVERWRITE=False

# False quando MinIO usa certificado próprio/não confiável.
# Se o endpoint S3 interno passar a usar TLS com certificado confiável,
# reavalie esta configuração.
# prod.py força AWS_S3_VERIFY=True; mantenha o endpoint/certificado compatível.
AWS_S3_VERIFY=True


# =============================================================================
# 9. CRIPTOGRAFIA DE CAMPOS SENSÍVEIS
# =============================================================================
# Gere uma chave Fernet de 44 caracteres:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ATENÇÃO: guarde esta chave em backup seguro. Perder ou trocar a chave
# impede a descriptografia dos dados já criptografados.

FIELD_ENCRYPTION_KEY=<PREENCHER_CHAVE_FERNET>


# =============================================================================
# 10. E-MAIL / SMTP
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<PREENCHER_HOST_SMTP>
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<PREENCHER_USUARIO_SMTP>
EMAIL_HOST_PASSWORD=<PREENCHER_SENHA_OU_APP_PASSWORD_SMTP>
DEFAULT_FROM_EMAIL=<PREENCHER_EMAIL_REMETENTE>
ADMIN_EMAIL=<PREENCHER_EMAIL_ADMINISTRADOR>


# =============================================================================
# 11. ASAAS
# =============================================================================
# HOMOLOGAÇÃO: use a chave e a URL de sandbox.
# PRODUÇÃO: use a chave e a URL de produção.
#
# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
#
# A chave do Asaas pode começar com "$". Ao armazená-la no .env, confira
# como o projeto carrega/interpreta esse valor. Não publique a chave.

ASAAS_API_KEY=<PREENCHER_CHAVE_ASAAS_DO_AMBIENTE>
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_CUSTOMER_ID=<PREENCHER_CUSTOMER_ID_ASAAS_SE_APLICAVEL>
ASAAS_PAYMENT_DUE_DAYS=1
ASAAS_WEBHOOK_TOKEN=<PREENCHER_TOKEN_FORTE_WEBHOOK_ASAAS>


# =============================================================================
# 12. GOOGLE OAUTH
# =============================================================================

GOOGLE_CLIENT_ID=<PREENCHER_CLIENT_ID_GOOGLE>


# =============================================================================
# 13. CORS / CSRF / COOKIES
# =============================================================================
# Informe origens completas, com https:// e sem barra final.
# Se frontend e backend estiverem em domínios diferentes, liste ambos onde
# aplicável. Não use curingas em produção.

CSRF_TRUSTED_ORIGINS=https://<PREENCHER_APP_DOMAIN>
CORS_ALLOWED_ORIGINS=https://<PREENCHER_APP_DOMAIN>

# Para frontend e backend em sites/domínios distintos:
COOKIE_SAMESITE=None
COOKIE_SECURE=True


# =============================================================================
# 14. SENTRY (OPCIONAL)
# =============================================================================
# Deixe SENTRY_DSN vazio para desabilitar o envio de eventos.

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1


# =============================================================================
# 15. IDENTIDADE DA LOJA / NOTIFICAÇÕES
# =============================================================================

STORE_NAME=Fórmula da Beleza
CONTACT_NOTIFICATION_EMAIL=<PREENCHER_EMAIL_QUE_RECEBE_CONTATOS>


# =============================================================================
# 16. DADOS LEGAIS — TERMOS DE USO E POLÍTICA DE PRIVACIDADE
# =============================================================================
# Preencha com os dados reais do controlador e do canal de privacidade.
# Não deixe os marcadores abaixo em um ambiente público.

LEGAL_COMPANY_NAME=<PREENCHER_RAZAO_SOCIAL_OU_NOME_DO_CONTROLADOR>
LEGAL_COMPANY_CNPJ=<PREENCHER_CNPJ>
LEGAL_COMPANY_ADDRESS=<PREENCHER_ENDERECO_INSTITUCIONAL>
LEGAL_CONTACT_EMAIL=<PREENCHER_EMAIL_DE_CONTATO_LGPD>
LEGAL_DPO_NAME=<PREENCHER_NOME_DO_ENCARREGADO_OU_CANAL>
LEGAL_DPO_EMAIL=<PREENCHER_EMAIL_DO_ENCARREGADO_OU_CANAL>
LEGAL_CONTACT_RETENTION_MONTHS=12
LEGAL_UNVERIFIED_ACCOUNT_RETENTION_DAYS=30


# =============================================================================
# 17. CAPACIDADE — GUNICORN / CELERY
# =============================================================================
# Valores iniciais para o host descrito no docker-compose.prod.yml
# (4 vCPU / 8 GB). Ajuste após observar CPU, memória, latência e fila.
#
# GUNICORN_WORKERS: processos worker do Gunicorn.
# GUNICORN_THREADS: threads por worker.
# GUNICORN_TIMEOUT: timeout de requisição em segundos.
# GUNICORN_LOG_LEVEL: nível de log do Gunicorn.
# CELERY_CONCURRENCY: processos de execução de tarefas Celery.

GUNICORN_WORKERS=4
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
CELERY_CONCURRENCY=4


# =============================================================================
# 18. TESTES / FLAGS OPERACIONAIS
# =============================================================================
# Não habilite em produção sem uma decisão explícita.
RATELIMIT_ENABLE=True