# syntax=docker/dockerfile:1.7
# =============================================================================
# Imagem de produção/homologação do backend (web, celery e celery-beat).
# Multi-stage: compila dependências no builder e leva só o runtime para o final.
# =============================================================================

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim-bookworm AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install -r requirements.txt


# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Bibliotecas de runtime: libpq (psycopg) e as do WeasyPrint (PDF do relatório).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        libglib2.0-0 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libharfbuzz-subset0 \
        libfontconfig1 \
        libfreetype6 \
        shared-mime-info \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Usuário sem privilégios (UID fixo para casar com permissões dos volumes).
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app . .

# O volume nomeado `static_volume` herda dono/permissão deste diretório.
RUN mkdir -p /app/staticfiles && chown -R app:app /app/staticfiles

USER app

EXPOSE 8000

# Comando padrão = API. Celery/beat/migrate sobrescrevem `command` no compose.
CMD ["gunicorn", "-c", "infra/gunicorn/gunicorn.conf.py", "beauty_formula.config.wsgi:application"]